{
  "expo": {
    "name": "CleanBy",
    "slug": "cleanby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cleanby",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salsalab.cleanby"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1628",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.salsalab.cleanby"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O CleanBy usa sua localização para encontrar lava-jatos próximos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A7AC8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
